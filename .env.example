# ---------------------------------------------------------------
# PlanMap CLI — environment template.
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#     cp .env.example .env
# ---------------------------------------------------------------

# Required ONLY for `planmap evolution` (LLM feature labelling).
# Everything else — parse, diff, check, watch, dependencies, impact —
# runs with no key at all.
#
# Source code never leaves the machine (DECISIONS.md §7.1): only
# declaration names and extracted facts are sent to the model.
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# PLANMAP_MAX_TAGS (default 8) is deliberately absent from this file.
# It is read from the real process environment ONLY — src/llm/config.js
# hand-parses this file for the single line `OPENROUTER_API_KEY=` and
# nothing else, so there is no dotenv loader to pick it up. Pass it
# inline instead:
#
#     PLANMAP_MAX_TAGS=12 node src/cli.js evolution
# ---------------------------------------------------------------
