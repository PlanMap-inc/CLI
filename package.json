{
  "name": "planmap",
  "version": "0.4.0",
  "description": "Catches the code changes that compile, pass tests, and pass review. Local semantic change detection for JavaScript.",
  "type": "module",
  "license": "BUSL-1.1",
  "author": "The PlanMap Authors",
  "bin": {
    "planmap": "src/cli.js"
  },
  "main": "src/cli.js",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "README.md",
    "DECISIONS.md",
    "LICENSE"
  ],
  "scripts": {
    "planmap": "node src/cli.js",
    "test:v1": "node src/cli.js parse test/v0.1/test.js",
    "test:v2": "node src/cli.js diff test/v0.2/before.js test/v0.2/after.js",
    "test:v0.6": "node test/v0.6/plan-draft-regression.mjs"
  },
  "keywords": [
    "static-analysis",
    "code-review",
    "drift-detection",
    "semantic-diff",
    "ai-coding-agents",
    "tree-sitter",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlanMap-inc/CLI.git"
  },
  "bugs": {
    "url": "https://github.com/PlanMap-inc/CLI/issues"
  },
  "homepage": "https://github.com/PlanMap-inc/CLI#readme",
  "dependencies": {
    "chokidar": "^5.0.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.12"
  }
}
