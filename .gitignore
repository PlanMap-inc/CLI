# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.turbo/
*.tsbuildinfo

# Framework caches
.next/
.vite/
.cache/

# Test / coverage
coverage/
.nyc_output/

# Env & secrets (BYO LLM keys must never be committed)
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp

# NOTE: .planmap/ is intentionally NOT ignored — the plan graph is committed to git by design.
# Exception: the example repos' stores are generated on demo startup, so keep them out.
examples/**/.planmap/

# Local scratch
/tmp/
scratch/

# Session / agent artifacts (not part of the product)
.remember/
